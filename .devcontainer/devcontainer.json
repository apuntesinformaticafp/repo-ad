{
  "name": "AD - prácticas y ejemplos Java/Python",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/repo-ad",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "tem",
      "installMaven": true,
      "mavenVersion": "3.9.9"
    },
    "ghcr.io/devcontainers/features/python:1": {"version": "3.12"},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "ms-python.python"]
    }
  },
  "postCreateCommand": "bash .devcontainer/comprobar.sh"
}
